      "isDeleted": false,
      "boundElements": [],
      "updated": 1794476584906,
      "created": 1794476103035,
      "link": null,
      "locked": false,
      "text": "     Since Atmost 5 horses can race at one time so lets group the 25 horses in 5\ngroups each and let Race them up.\nso we will have total of 5 races and lets say we get this order",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "     Since Atmost 5 horses can race at one time so lets group the 25 horses in 5 groups each and let Race them up.\nso we will have total of 5 races and lets say we get this order",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "7VbBtpMHZjP41SlgRHqB1",
      "type": "text",
      "x": 853.1427612304688,
      "y": 2807.071533203125,
      "width": 343.78617010504,
      "height": 194.8570556640625,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
