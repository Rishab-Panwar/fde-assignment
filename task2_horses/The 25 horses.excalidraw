    {
      "id": "REgnonwOcumRRiBM97gTT",
      "type": "text",
      "x": 850.2858276367188,
      "y": 3067.6428833007812,
      "width": 221.75991821289062,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
