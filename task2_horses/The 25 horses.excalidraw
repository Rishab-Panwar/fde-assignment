      "created": 1794476407744,
      "link": null,
      "locked": false,
      "text": "Races         Result\n1            A1 > A2 > A3 > A4 > A5\n2            B1 > B2 > B3 > B4 > B5\n3            C1 > C2 > C3 > C4 > C5\n4           D1 > D2 > D3 > D4 > D5\n5           E1 > E2 > E3 > E4 > E5\n\n",
      "fontSize": 19.485705566406242,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Races         Result\n1            A1 > A2 > A3 > A4 > A5\n2            B1 > B2 > B3 > B4 > B5\n3            C1 > C2 > C3 > C4 > C5\n4           D1 > D2 > D3 > D4 > D5\n5           E1 > E2 > E3 > E4 > E5\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
